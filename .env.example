# Copy to .env (gitignored) and fill in. Never commit .env.

# The teamctx binary the prototype tests (a build with the loopback [discord] api_url setting).
TEAMSIM_TEAMCTX_BINARY=

# Optional: an OpenRouter key, passed only to the teamctx child process for /ask.
TEAMCTX_LLM_KEY=

# The WSL side of the Discord emulator (live runs only; leave empty if you do not run them).
# The WSL distro that runs the emulator. No default: a live run stops with an error until it is set.
TEAMSIM_WSL_DISTRO=
# Optional: the user that runs commands in that distro. Empty means the distro's default user.
TEAMSIM_WSL_USER=
# Optional: where the emulator lives inside the distro. Empty means ~/teamsim-emu.
TEAMSIM_EMU_REMOTE_DIR=
